        {
          "name": "Ingest Consistent Event Group",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"eventId\": \"EVT-CONSISTENT-100\",\n    \"source\": \"SOURCE_A\",\n    \"value\": 72.4,\n    \"timestamp\": \"2026-08-23T10:30:00Z\"\n  },\n  {\n    \"eventId\": \"EVT-CONSISTENT-100\",\n    \"source\": \"SOURCE_B\",\n    \"value\": 72.5,\n    \"timestamp\": \"2026-08-23T10:30:01Z\"\n  },\n  {\n    \"eventId\": \"EVT-CONSISTENT-100\",\n    \"source\": \"SOURCE_C\",\n    \"value\": 72.6,\n    \"timestamp\": \"2026-08-23T10:30:02Z\"\n  }\n]"
            },
            "url": {
              "raw": "{{base_url}}/events",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "events"
              ]
            }
          }
        },
